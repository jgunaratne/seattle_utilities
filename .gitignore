# Local credentials and per-account configuration
nextcentury_credentials.conf
*.local
.env
.env.*

# Runtime state, tokens, and fetched private data
*_state.json
work/

# Google service-account key (never commit credentials)
google_service_account.json
*service_account*.json
*.iam.gserviceaccount.com.json
# Google downloads SA keys as "<project-id>-<keyid>.json", which none of the patterns
# above match. No *.json is tracked at the repo root, so ignore them all rather than
# leave a freshly downloaded key committable.
/*.json

# config/ holds real secrets (credentials + service-account key); only the
# *.example templates are tracked. (.example files don't end in .json/.conf.)
config/*.json
config/*.conf

# Generated billing outputs
output/
spu_bill_split_*.csv
sheet_upload_*.csv

# Manual per-cycle private adjustments
hoa_adjustments.json

# Python cache/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Editor/OS noise
.DS_Store
.idea/
.vscode/

# Python virtualenv
.venv/
venv/
