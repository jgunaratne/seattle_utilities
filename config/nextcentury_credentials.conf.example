# Copy this file to config/nextcentury_credentials.conf and fill in local values.
# config/nextcentury_credentials.conf is ignored by git.

# NextCentury portal credentials and property settings
NC_EMAIL="you@example.com"
NC_PASSWORD="replace-me"
NC_PROPERTY_ID="p_REPLACE_ME"
NC_UNIT_NAMES="UNIT_1,UNIT_2,UNIT_3"

# Seattle MyUtilities credentials and account settings
SEATTLE_UTIL_USERNAME="replace-me"
SEATTLE_UTIL_PASSWORD="replace-me"
SPU_ACCOUNT_NUMBER="replace-me"

# Optional: Google Sheet upload (seattle_bill.py sheet).
# GOOGLE_SHEET_ID is the long id in the sheet URL: .../spreadsheets/d/<THIS>/edit
# GOOGLE_SA_KEYFILE is the path to a Google service-account JSON key. Create the service
# account in Google Cloud, enable the Google Sheets API, then SHARE the sheet with the
# service account's email (…@….iam.gserviceaccount.com) as an Editor. Drop the key file
# in this config/ folder; a bare filename is resolved relative to config/ (or use an
# absolute path).
#
# NOTE: a plain API key cannot WRITE to a private sheet — Sheets writes require an
# authenticated identity (service account or OAuth user), so this pipeline uses the
# service-account keyfile below, not an API key.
GOOGLE_SHEET_ID="replace-me"
GOOGLE_SA_KEYFILE="google_service_account.json"
